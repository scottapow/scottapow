---
import type { HTMLAttributes, HTMLTag } from 'astro/types';

type Props<C extends Extract<HTMLTag, 'input' | 'textarea'> = 'input'> = HTMLAttributes<C> & {
  component?: C;
};
const { class: className, component, ...props } = Astro.props;
const Component = component ?? 'input';
---
<Component class:list={['form-input', className]} {...props} />

<style>
  .form-input {
    width: 100%;
    padding: 0.25rem .375rem;
    background-color: var(--color-aquamarine-100);
    border-inline-start: .125rem solid var(--shadow-color);
    border-block-end: .125rem solid var(--shadow-color);

    @media (prefers-color-scheme: dark) { 
      color: var(--color-french-violet-700);
    }

    &:not(:placeholder-shown):not(:focus-visible) {
      &:valid {
        --shadow-color: var(--color-valid);

        label:has(+ &) { border-color: var(--color-valid) }
      }
      &:invalid {
        --shadow-color: var(--color-invalid);
      }
    }
  }
</style>
