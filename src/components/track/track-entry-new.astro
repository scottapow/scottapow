---
import Button from "../button.astro";
import Form from "../form";
import Note from "../icon/note.astro";
import Typography from "../typography.astro";
import { CN_ENTRY_FORM, CN_THINGID_INPUT, CN_THING_VALUE_LABEL, CN_THING_LABEL_NOTE, CN_THING_FIELD_NOTE, ID_TRACK_NEW_WRAP, CN_THINGNAME_HEADING, CN_THING_VALUE_INPUT, CN_THINGNAME_HEADING_STEP } from "../../features/track/constants";

type Props = {
  slug: string;
}

const { slug } = Astro.props;
---
<div id={ID_TRACK_NEW_WRAP} class="wrapper" data-slug={slug}>
  <template class={CN_ENTRY_FORM}>
    <form method="post" data-current-step="1">
      <Form.Input class={CN_THINGID_INPUT} name="thingId" type="hidden" />
      <Typography variant="h4" component="h3">
        <span class={CN_THINGNAME_HEADING}></span>
        <span class:list={[CN_THINGNAME_HEADING_STEP, 'step']}>(Step 1 of 3)</span>
      </Typography>

      <div>
        <fieldset data-step="1">
          <Form.Label class={CN_THING_VALUE_LABEL}>Value</Form.Label>
          <Form.Input class={CN_THING_VALUE_INPUT} placeholder="Enter a value" name="value" required type="number" />
        </fieldset>

        <fieldset data-step="2">
          <Form.Label class={CN_THING_LABEL_NOTE}>Note</Form.Label>
          <Form.Input class={CN_THING_FIELD_NOTE} placeholder="Optional Note" name="note" type="text" />
        </fieldset>

        <fieldset data-step="3">
          <div class="datetime-fields">
            <div class="date-field">
              <Form.Label for="date">Date</Form.Label>
              <Form.Input required type="date" id="date" name="date" />
            </div>
            <div class="time-field">
              <Form.Label for="time">Time</Form.Label>
              <Form.Input required type="time" id="time" name="time" step="60" />
            </div>
          </div>
        </fieldset>
      </div>

      <div class="actions">
        <Button size="sm" type="button" variant="secondary" class="entry-btn-back">Back</Button>
        <Button size="sm" type="button" variant="secondary" class="entry-btn-next">Next</Button>
        <Button size="sm" type="submit" variant="primary" class="entry-btn-submit">Log</Button>
      </div>
    </form>
  </template>
</div>

<script>
import { ClientDB, thingCreateEventType } from "../../features/db/client";
import type { ITrackThing } from "../../features/track/types";
import { CN_ENTRY_FORM, CN_THING_FIELD_NOTE, CN_THING_LABEL_NOTE, CN_THING_VALUE_INPUT, CN_THING_VALUE_LABEL, CN_THINGID_INPUT, CN_THINGNAME_HEADING, CN_THINGNAME_HEADING_STEP, ID_TRACK_NEW_WRAP } from "../../features/track/constants";
import { dayChangeEventType, minuteChangeEventType } from "../../utils/dateTimeEvents";
import { getInputDate, getInputTime } from "../../utils/formatDateTimeForInput";

function createThingForm(thing: ITrackThing) {
  let _form = document.querySelector(`.${CN_ENTRY_FORM}`)! as HTMLTemplateElement;
  let form = _form.content.cloneNode(true) as HTMLFormElement;

  let thingIdInput = form.querySelector(`.${CN_THINGID_INPUT}`)!;
  thingIdInput.setAttribute('value', thing.id.toString());

  let thingNameHeading = form.querySelector(`.${CN_THINGNAME_HEADING}`)!;
  thingNameHeading.textContent = `Log ${thing.name}`;

  let valInput = form.querySelector(`.${CN_THING_VALUE_INPUT}`)!;
    valInput.id = `${thing.id}-value`;
  let valLabel = form.querySelector(`.${CN_THING_VALUE_LABEL}`)!;
    valLabel.textContent = thing.name;
    valLabel.setAttribute('for', valInput.id);

  let noteInput = form.querySelector(`.${CN_THING_FIELD_NOTE}`)! as HTMLInputElement;
    noteInput.id = `${thing.id}-note`;
  let noteLabel = form.querySelector(`.${CN_THING_LABEL_NOTE}`)! as HTMLLabelElement;
    noteLabel.setAttribute('for', noteInput.id);

  return form;
}

function addThingsFieldsToNewEntryForm(things: ITrackThing[]) {
  let entriesContainer = document.getElementById(ID_TRACK_NEW_WRAP)!;
  let forms = things.map(createThingForm);
  entriesContainer.append(...forms);
  
  Array.from(entriesContainer.querySelectorAll('form') ?? []).map(f => {
    // form submission
    f.addEventListener('submit', handleFormSubmit);

    // Add multi-step
    let header = f.querySelector(`.${CN_THINGNAME_HEADING_STEP}`) as HTMLHeadingElement;

    let btnBack = f.querySelector('.entry-btn-back')! as HTMLButtonElement;
    btnBack.addEventListener('click', () => { 
      let currentStep = Number(f.dataset.currentStep ?? '1');
      let step = (currentStep - 1) || 1;
      f.setAttribute('data-current-step', step.toString());
      header.textContent = '(Step ' + step + ' of 3)';
    });

    let btnNext = f.querySelector('.entry-btn-next')! as HTMLButtonElement;
    btnNext.addEventListener('click', () => { 
      let currentStep = Number(f.dataset.currentStep ?? '1');
      let step = Math.min(((currentStep + 1) || 1), 3);
      let isValid = f.checkValidity();
      if (isValid) {
        f.setAttribute('data-current-step', step.toString());
        header.textContent = '(Step ' + step + ' of 3)';
      } else {
        f.reportValidity();
      }
    });

    // set default time/date
    setDateTimeToNow(f);

    let dateInput = f.querySelector('input[type=date]') as HTMLInputElement;
    let timeInput = f.querySelector('input[type=time]') as HTMLInputElement;
    f.addEventListener(minuteChangeEventType, (e: CustomEventInit<Date>) => {
      let now = e.detail || new Date();
      let time = getInputTime(now);
      timeInput.value = time;
    })
    f.addEventListener(dayChangeEventType, (e: CustomEventInit<Date>) => {
      let now = e.detail || new Date();
      let date = getInputDate(now);
      dateInput.value = date;
    })
  })
}

async function handleFormSubmit(this: HTMLFormElement, ev: Event) {
  ev.preventDefault();
  
  const Store = new ClientDB();
  await Store.connect("TRACKS");

  let formData = new FormData(this);
  let formObj = Object.fromEntries(formData.entries());
  let startAt = new Date(`${formObj.date} ${formObj.time}`);
  let key = await Store.addEntry({
    startAt,
    endAt: null,
    loggedAt: new Date().toUTCString(),
    note: formObj.note.toString(),
    thingId: Number(formObj.thingId),
    value: Number(formObj.value),
  });
  this.reset();
  this.dataset.currentStep = "1";
  setDateTimeToNow(this);
  let header = this.querySelector(`.${CN_THINGNAME_HEADING_STEP}`) as HTMLHeadingElement;
  header.textContent = '(Step 1 of 3)';
}

function setDateTimeToNow(f: HTMLFormElement) {
  let dateInput = f.querySelector('input[type=date]') as HTMLInputElement;
  let timeInput = f.querySelector('input[type=time]') as HTMLInputElement;
  if (dateInput && timeInput) {
    let now = new Date();
    let date = getInputDate(now);
    let time = getInputTime(now);
    dateInput.value = date;
    timeInput.value = time;
  }
}

(async () => {
  const Store = new ClientDB();
  await Store.connect("TRACKS");

  let wrapper = document.getElementById(ID_TRACK_NEW_WRAP)!;
  if (!wrapper) return;

  let trackSlug = wrapper.dataset.slug;
  if (!trackSlug) return;

  const track = await Store.getTrackBySlug(trackSlug);
  const things = await Store.getThingsById(track.id);
  addThingsFieldsToNewEntryForm(things);
})();

</script>

<style>
  form fieldset { display: none; }
  form {
    --pad: 1rem;
    display: grid;
    column-gap: .75rem;
    row-gap: var(--pad);
    border-width: .25rem;
    border-color: light-dark(var(--color-azure-900), var(--color-azure-600));
    padding: var(--pad);
    grid-template-columns: 1fr auto;
    align-items: end;

    & > :is(h2,h3,h4,h5,h6) {
      margin-inline: calc(-1 * var(--pad));
      margin-block-start: calc(-1 * var(--pad));
      padding-block: calc(var(--pad) / 2);
      padding-inline: var(--pad);
      border-block-end: 1px solid var(--color-text);
      grid-column: span 2;
    }

    @container (width < 448px) {
      column-gap: 0;
      & .actions {
        grid-column: span 2;
      }
    }
  }

  form[data-current-step=1] {
    .entry-btn-back { display: none; }
    .entry-btn-submit { display: none; }

    & fieldset:nth-of-type(1) { display: grid; }
  }

  form[data-current-step=2] {
    .entry-btn-submit { display: none; }
    
    & fieldset:nth-of-type(2) { display: grid; }
  }
  
  form[data-current-step=3] {
    .entry-btn-next { display: none; }
    & fieldset:nth-of-type(3) { display: grid; }
  }

  .step {
    font-size: .75em;
    white-space: nowrap;
  }

  .wrapper {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 1.5rem;
    container-type: inline-size;
  }

  .actions {
    display: flex;
    gap: .5rem;
    justify-content: flex-end;
  }

  legend, .legend {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .datetime-fields {
    display: flex;
    gap: .25rem;
  }

  ::view-transition-group(root) {
    animation-duration: 0.5s;
  }

  ::view-transition-group(form-refresh) {
    height: 100%;
  }
  
  form, fieldset {
    view-transition-name: form-refresh;
  }

</style>