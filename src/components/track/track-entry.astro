---
import type { HTMLAttributes } from "astro/types";
import Typography from '../typography.astro';
import Button from "../button.astro";
import CaretDown from "../icon/caret-down.astro";
import Form from "../form";

export const CN_ENTRY = 'entry';
export const CN_ENTRY_EMPTY = 'empty';
export const CN_ENTRY_NAME = 'entry-name';
export const CN_ENTRY_VALUE = 'entry-value';

type Props = HTMLAttributes<'div'>;
const { class: className, ...props } = Astro.props;
---
<details class:list={[CN_ENTRY, CN_ENTRY_EMPTY, className]} {...props}>
  <Typography variant="p" component="summary" class="summary">
    <div class="overview">
      <Typography variant="lead" component="strong" class={CN_ENTRY_NAME}>Calories</Typography>
      <Typography variant="lead" component="span" class={CN_ENTRY_VALUE}>2000</Typography>
    </div>
  </Typography>

  <div class="entries">
    
  </div>
</div>

<style>
  .entry {
    &[open] .overview::after {
      content: '▲';
    }
  }
  .entry-name {
  }
  .entry-value {
    text-decoration: underline;
    text-decoration-style: double;
    padding: .5rem .25rem;
  }
  .empty {
    /* display: none; */
  }
  .summary {
    .overview::after {
      content: '▼';
      display: block;
      margin-inline-start: auto;
      border: 1px solid var(--color-text);
      line-height: 24px;
      font-family: math;
      font-size: 10px;
      width: 24px;
      height: 24px;
      text-align: center;
    }
  }
  .summary::marker {
    content: none;
  }
  .summary
  .overview {
    display: inline-flex;
    align-items: center;
    width: 100%;
    gap: .5rem;

    button {
      margin-left: auto;
    }
  }
</style>