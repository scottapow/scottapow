---
import type { HTMLAttributes } from "astro/types";
import Typography from '../typography.astro';
import { ID_ENTRIES_WRAP, CN_ENTRY, CN_ENTRY_NAME, CN_ENTRY_VALUE, CN_ENTRY_DETAIL } from "../../features/track/constants";

type Props = { slug: string } & HTMLAttributes<'div'>;
const { slug, class: className, ...props } = Astro.props;
---
<div id={ID_ENTRIES_WRAP} data-slug={slug}>
  <template class={CN_ENTRY}>
    <details class:list={[className, 'entries-details']} {...props}>
      <Typography variant="p" component="summary" class="summary">
        <div class="overview">
          <Typography variant="lead" component="strong" class={CN_ENTRY_NAME}>Calories</Typography>
          <Typography variant="lead" component="span" class:list={[CN_ENTRY_VALUE, 'value']}>2000</Typography>
        </div>
      </Typography>

      <table class="entries">
        <thead>
          <tr>
            <th>Time</th>
            <th>Value</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          
        </tbody>
      </ul>
    </details>
  </template>
</div>

<script>
import { ClientDB, entryCreateEventType } from "../../features/db/client";
import { CN_ENTRY, CN_ENTRY_DETAIL, CN_ENTRY_NAME, CN_ENTRY_VALUE, ID_ENTRIES_WRAP } from "../../features/track/constants";
import type { ITrackThing } from "../../features/track/types";

(async () => {
  const Store = new ClientDB();
  await Store.connect("TRACKS");

  let wrapper = document.getElementById(ID_ENTRIES_WRAP)!;
  if (!wrapper) return;

  let trackSlug = wrapper.dataset.slug;
  if (!trackSlug) return;

  const track = await Store.getTrackBySlug(trackSlug);
  const things = await Store.getThingsById(track.id);
  addThingsEntries(things);

  document.addEventListener(entryCreateEventType, () => {
    addThingsEntries(things);
  })
})();

async function addThingsEntries(things: ITrackThing[]): Promise<void> {
  let wrapper = document.getElementById(ID_ENTRIES_WRAP)!;
  let entryTemplate = document.querySelector(`.${CN_ENTRY}`)! as HTMLTemplateElement;
  wrapper.replaceChildren();
  wrapper.appendChild(entryTemplate);

  const Store = new ClientDB();
  await Store.connect("TRACKS");

  let results = await Promise.all(things.map(async (thing: ITrackThing) => {
    let detailsEl = entryTemplate.content.cloneNode(true) as HTMLDetailsElement;
    let thingNameEl = detailsEl.querySelector(`.${CN_ENTRY_NAME}`)!;
    let thingTotalEl = detailsEl.querySelector(`.${CN_ENTRY_VALUE}`)!;
    
    let entries = await Store.getEntriesDaily(thing);

    if (thing.type === 'number') {
      let total = entries.reduce((acc, cur) => {
        acc += cur.value as number;
        return acc;
      }, 0);
      thingTotalEl.textContent = total ? total.toString() : 'Nothing Today';
    }

    thingNameEl.textContent = thing.name;

    let entriesWrapperEl = detailsEl.querySelector('.entries tbody')!; 
    entriesWrapperEl.append(...entries.toSorted((a, b) => b.startAt.getTime() - a.startAt.getTime()).map((en) => {
      let entriesTREl = document.createElement('tr');
      let time = document.createElement('td');
      time.textContent = en.startAt.toLocaleTimeString().replace(/:\d\d /, ' ');
      let value = document.createElement('td');
      value.textContent = en.value.toString();
      let note = document.createElement('td');
      note.textContent = en.note;
      entriesTREl.append(time, value, note);
      return entriesTREl;
    }))
    return detailsEl;
  }));

  wrapper.append(...results);
}
</script>

<style>
  .entries-details {
    &[open] .overview::after {
      content: '▲';
    }
    margin-block-end: 2rem;
  }
  .value {
    text-decoration: underline;
    text-decoration-style: double;
    padding: .5rem .25rem;
  }
  .summary {
    .overview::after {
      content: '▼';
      display: block;
      margin-inline-start: auto;
      border: 1px solid var(--color-text);
      line-height: 24px;
      font-family: math;
      font-size: 10px;
      width: 24px;
      height: 24px;
      text-align: center;
    }
  }
  .summary::marker {
    content: none;
  }
  .summary
  .overview {
    display: inline-flex;
    align-items: center;
    width: 100%;
    gap: .5rem;

    button {
      margin-left: auto;
    }
  }

  .entries {
    width: 100%;
    border-spacing: .25rem;
    border: 1px solid var(--color-text);

    & thead {
      text-align: left;
      border: 1px solid var(--color-text);

      & th {
        padding-inline: .75rem;
        padding-block: .25rem;

        &:not(:last-of-type):not(:first-of-type) {
          border-inline: 1px solid var(--color-text);
        }
      }
    }

    & :global(td) {
      padding-inline: .75rem;
      padding-block: .25rem;

      &:not(:last-of-type):not(:first-of-type) {
        border-inline: 1px solid var(--color-text);
      }
    }
  }

</style>