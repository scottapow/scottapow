---
import type { HTMLAttributes } from "astro/types";

export type ButtonVariant = "primary" | "secondary";
export type ButtonSize = "sm" | 'md' | "lg";
type Props = HTMLAttributes<"button"> & {
  variant?: ButtonVariant;
  size?: ButtonSize;
};

const { variant = "primary", size = 'md', class: className, ...props } = Astro.props;
---
<button class:list={["button", className, variant, size]} {...props}>
  <slot />
</button>

<style>
  .sm {
    padding-block: 4px;
    padding-inline: 8px;
  }
  .md {
    padding-block: 8px;
    padding-inline: 12px;
  }
  .lg {
    padding-block: 12px;
    padding-inline: 16px;
  }
  .button {
    font-weight: bold;
  }

  .primary {
    background-color: var(--color-french-violet-700);
    color: var(--color-french-violet-100);

    @media (prefers-color-scheme: dark) {
      background-color: var(--color-french-violet-100);
      color: var(--color-french-violet-900);
    }
  }

  .secondary {
    border: 1px solid var(--color-text);
    color: var(--color-text);
  }
</style>
