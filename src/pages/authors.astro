---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Typography from "../components/typography.astro";
import AuthorListItem from "../features/stories/authors/AuthorListItem.astro";
import Card from "../components/card.astro";

const authors = await getCollection('authors');

---
<Layout title="Authors" description="A list of potentially fictional authors">

  <Card>
    <div class="authors-container">
      {authors.map((author => (
        <div class="author">
          <AuthorListItem 
            description={author.data.description} 
            fullname={`${author.data.firstname} ${author.data.surname}`} 
            headshotURL={author.data.headshot_url!} 
            slug={author.id} 
          />
        </div>
      )))}
    </div>
  </Card>
</Layout>

<style>
  .authors-container {
    display: flex;
    gap: 1.5rem;
  }
  .author {
    max-width: 480px;
  }
</style>